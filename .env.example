# Template for local development against a TrueNAS test appliance.
#
#   cp .env.example .env    # then fill in the real values
#
# .env is gitignored and must never be committed. The CI equivalent of the
# API key is the GitHub secret DEV_TRUENAS_API_KEY.
#
# NEVER point these at a production TrueNAS. Production holds live VM disks
# as zvols, and the functional suite creates and deletes volumes.

# Base URL of the appliance. The client accepts either form -- with or
# without the /api/v2.0 suffix.
TRUENAS_API_URL=https://CHANGEME

# API key for a service account on the test appliance only.
# Create one under Credentials -> API Keys in the TrueNAS UI.
TRUENAS_API_KEY=CHANGEME

# Scratch pool for verification and functional tests. Anything in this pool
# may be created and destroyed without warning.
TRUENAS_TEST_POOL=CHANGEME

# Set to 0 for a self-signed certificate or a plain-HTTP appliance.
TRUENAS_VERIFY_SSL=1
